              "name": "完整规范路径",
              "fill": "#505750",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "完整规范：docs/superpowers/specs/2026-06-21-health-monitor-daily-rhythm-ui-spec.md",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "principlesBlock",
          "name": "核心原则",
          "width": "fill_container",
          "fill": "#FFFDF8",
          "cornerRadius": 24,
          "stroke": "#DDD8CF",
          "layout": "vertical",
          "gap": 8,
          "padding": 18,
          "children": [
            {
              "type": "text",
              "id": "principlesTitle",
              "name": "核心原则标题",
              "fill": "#1F2320",
              "content": "核心原则",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "principlesText",
              "name": "核心原则内容",
              "fill": "#505750",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• 温和陪伴，不制造健康焦虑\n• 先给结论，再解释依据\n• 不做医学诊断，不展示未定义医学指标\n• 页面只消费聚合后的 UI 数据\n• 通过留白、分组和排版建立层级，避免卡片套卡片",
              "lineHeight": 1.65,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "layoutBlock",
          "name": "布局与尺寸",
          "width": "fill_container",
          "fill": "#FFFDF8",
          "cornerRadius": 24,
          "stroke": "#DDD8CF",
          "layout": "vertical",
          "gap": 8,
          "padding": 18,
          "children": [
            {
              "type": "text",
              "id": "layoutTitle",
              "name": "布局标题",
              "fill": "#1F2320",
              "content": "布局与尺寸",
              "fontFamily": "Inter",
              "fontSize": 16,
