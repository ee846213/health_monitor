    {
      "type": "frame",
      "id": "designBrief",
      "x": 450,
      "y": 0,
      "name": "生活节奏轴 - 设计规范",
      "width": 560,
      "height": 1180,
      "fill": "#F5F3EE",
      "cornerRadius": 32,
      "stroke": "#DDD8CF",
      "layout": "vertical",
      "gap": 20,
      "padding": 28,
      "children": [
        {
          "type": "text",
          "id": "briefTitle",
          "name": "规范标题",
          "fill": "#1F2320",
          "content": "生活节奏轴 UI 设计规范",
          "fontFamily": "Inter",
          "fontSize": 30,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "briefIntro",
          "name": "规范简介",
          "fill": "#505750",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "目标：为健康监测 App 建立温和、可解释、低打扰的今日总览。用一天的节奏串联活动、姿势、环境噪音和数字习惯，不把首页做成高压式医学仪表盘。",
          "lineHeight": 1.55,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "sourceBlock",
          "name": "设计来源",
          "width": "fill_container",
          "fill": "#FFFDF8",
          "cornerRadius": 24,
          "stroke": "#DDD8CF",
          "layout": "vertical",
          "gap": 8,
          "padding": 18,
          "children": [
            {
              "type": "text",
              "id": "sourceTitle",
              "name": "设计来源标题",
              "fill": "#1F2320",
              "content": "设计来源",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "sourceReference",
              "name": "视觉参考路径",
              "fill": "#505750",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "视觉参考：docs/designs/health-monitor-daily-rhythm-reference.png",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
